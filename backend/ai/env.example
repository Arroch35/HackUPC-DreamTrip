# ── LLM Provider (pick one) ───────────────────────────────────────────
# Explicitly override auto-detection:
# LLM_PROVIDER=openai | gemini | anthropic | mock
LLM_PROVIDER=mock

OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=your_google_key_here
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=your_anthropic_key_here
CLAUDE_MODEL=claude-3-haiku-20240307

# ── Skyscanner Partner API ────────────────────────────────────────────
SKYSCANNER_API_KEY=your_skyscanner_key_here

# ── ElevenLabs Voice (TTS) ────────────────────────────────────────────
# REQUIRED for /api/voice/speak to work.
# Get your key at: https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Voice ID — default is "Rachel" (warm, clear, English)
# Browse voices at: https://elevenlabs.io/voice-library
# To find a voice ID: API > GET /v1/voices
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Model — eleven_multilingual_v2 is best quality on Creator plan
# Options: eleven_monolingual_v1 | eleven_multilingual_v2 | eleven_turbo_v2
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Server ────────────────────────────────────────────────────────────
PORT=8000
